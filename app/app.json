{
  "expo": {
    "name": "Mathpex",
    "slug": "qmath",
    "version": "1.0.0",
    "description": "Multiplayer math game — solve fast or get eliminated. Last one standing wins.",
    "privacyPolicyUrl": "https://mathpex.twozer00.dev/privacy.html",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0f"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.twozer00.algebrawl",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "dev.twozer00.algebrawl",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": []
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-audio",
      "expo-localization",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "0e827f50-b27b-40b4-8cde-50df34a49465"
      }
    }
  }
}
