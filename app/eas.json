{
  "cli": {
    "version": ">= 21.8.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_USE_EMULATOR": "false",
        "EXPO_PUBLIC_WS_URL": "wss://qmath.onrender.com",
        "EXPO_PUBLIC_MIN_PLAYERS": "5",
        "EXPO_PUBLIC_MAX_VOTE_ROUNDS": "2"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
