PORT=3000
MIN_PLAYERS=2
MAX_PLAYERS=20
MAX_VOTE_ROUNDS=2
TIME_LIMIT=5
LOBBY_WAIT=15
VOTE_WAIT=10
RESTART_WAIT=5
ROUND_WAIT=3
# Desarrollo local con emulador Firebase
USE_EMULATOR=true
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# Producción — JSON de la service account de Firebase
# FIREBASE_SERVICE_ACCOUNT=
