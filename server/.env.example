PORT=3000
MIN_PLAYERS=2
MAX_PLAYERS=20
MAX_VOTE_ROUNDS=2
TIME_LIMIT=5
LOBBY_WAIT=15
VOTE_WAIT=10
RESTART_WAIT=5
ROUND_WAIT=3

# Local — usar emuladores de Firebase
USE_EMULATOR=true
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIRESTORE_EMULATOR_HOST=localhost:8080

# Producción — pegar el JSON de la service account de Firebase
# USE_EMULATOR=false
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# Valores recomendados para producción:
# MIN_PLAYERS=5
# TIME_LIMIT=5
# LOBBY_WAIT=15
